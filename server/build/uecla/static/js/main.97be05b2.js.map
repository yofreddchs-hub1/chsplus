const Boleta = (doc, tamcuadroI, margen, margenAlto, altoTexto, tamimagen, letra, datos, estudiante, est_titulos)=>{
    // let imgData = getImageFromUrl("logo.jpg");
    // doc.addImage(imgData, 'JPEG', 10, 10, 50, 50, 'monkey'); // Cache the image using the alias 'monkey'
	// doc.addImage('monkey', 70, 10, 100, 120); // use the cached 'monkey' image, JPEG is optional regardl
    var image = new Image();
    image.src = 'https://dev.raqlan.com/api/imagen/logoboleta.png'
    doc.addImage(image, "JPEG", margen+2.5, margenAlto+2.5, tamimagen - 5, tamimagen -5);
    let inicia = tamimagen+margen;
    let siguientew = 0;
    let siguienteA =margenAlto+altoTexto;
    let texto='';
    doc.setLineWidth(0.5);
    doc.setFont("arial");
    doc.setFontSize(letra)

    doc=Celda(doc,'BOLETIN DE CALIFICACIONES' , tamimagen+margen, margenAlto, tamcuadroI, altoTexto, letra)
    siguientew = tamcuadroI*0.55;
    
    doc=Celda(doc,'APELLIDOS Y NOMBRES DEL ESTUDIANTE' , inicia, siguienteA, siguientew, altoTexto, letra)
    // doc.rect(inicia, siguienteA, siguientew, altoTexto); //
    // texto = 'APELLIDOS Y NOMBRES DEL ESTUDIANTE';
    // medio = inicia +(siguientew/2)//-((texto.length/2)+letra+letra)
    // doc.text(texto, medio, (siguienteA+altoTexto)-(letra/3), null, null, "center");

    inicia+=siguientew;
    siguientew = tamcuadroI*0.2;
    doc=Celda(doc, 'COD. PLANTEL', inicia, siguienteA, siguientew, altoTexto, letra)
    // doc.rect(inicia, siguienteA, siguientew, altoTexto); //
    // texto = 'COD. PLANTEL';
    // medio = inicia +(siguientew/2)//2
    // doc.text(texto, medio, (siguienteA+altoTexto)-(letra/3), null, null, "center");

    inicia+=siguientew;
    siguientew = tamcuadroI*0.125;
    doc=Celda(doc, 'CURSO', inicia, siguienteA, siguientew, altoTexto, letra)
    // doc.rect(inicia, siguienteA, siguientew, altoTexto); //
    // texto = 'CURSO';
    // medio = inicia +(siguientew/2)//2
    // doc.text(texto, medio, (siguienteA+altoTexto)-(letra/3), null, null, "center");

    inicia+=siguientew;
    siguientew = tamcuadroI*0.125;
    doc=Celda(doc, 'SECC', inicia, siguienteA, siguientew, altoTexto, letra)
    // doc.rect(inicia, siguienteA, siguientew, altoTexto); //
    // texto = 'SECC';
    // medio = inicia +(siguientew/2)//2
    // doc.text(texto, medio, (siguienteA+altoTexto)-(letra/3), null, null, "center");

    //==================================

    inicia = tamimagen+margen;
    siguienteA +=altoTexto;
    siguientew = tamcuadroI*0.55;
    //==============Nombre y apellido de Estudiante
    doc=Celda(doc, estudiante && estudiante.nombres && estudiante.apellidos ? `${estudiante.apellidos} ${estudiante.nombres} `:'', inicia, siguienteA, siguientew, altoTexto, letra,'center','bold')
    
    //==============Codigo plantel
    inicia+=siguientew;
    siguientew = tamcuadroI*0.2;
    doc=Celda(doc, 'PD00151114', inicia, siguienteA, siguientew, altoTexto, letra,'center','bold')
    
    //==============Curso
    inicia+=siguientew;
    siguientew = tamcuadroI*0.125;
    doc=Celda(doc, datos.grado, inicia, siguienteA, siguientew, altoTexto, letra,'center','bold')
    
    //==============Seccion
    inicia+=siguientew;
    siguientew = tamcuadroI*0.125;
    doc=Celda(doc, datos.seccion, inicia, siguienteA, siguientew, altoTexto, letra,'center','bold')
    
    
    //==================================

    inicia = tamimagen+margen;
    siguienteA +=altoTexto;
    siguientew = tamcuadroI*0.25;
    doc=Celda(doc, 'CÉDULA DE IDENTIDAD', inicia, siguienteA, siguientew, altoTexto, letra)
    
    inicia+=siguientew;
    siguientew = tamcuadroI*0.25;
    doc=Celda(doc, 'FECHA DE NACIMIENTO', inicia, siguienteA, siguientew, altoTexto, letra)
    
    inicia+=siguientew;
    siguientew = tamcuadroI*0.25;
    doc=Celda(doc, 'LUGAR DE NACIMIENTO', inicia, siguienteA, siguientew, altoTexto, letra)

    inicia+=siguientew;
    siguientew = tamcuadroI*0.25;
    doc=Celda(doc, 'ENTIDAD FEDERAL', inicia, siguienteA, siguientew, altoTexto, letra)

    //==================================

    inicia = tamimagen+margen;
    siguienteA +=altoTexto;
    siguientew = tamcuadroI*0.25;
    //================Cedula del estudiante
    doc=Celda(doc, estudiante && estudiante.cedula ? estudiante.cedula : '', inicia, siguienteA, siguientew, altoTexto, letra,'center','bold')
    
    inicia+=siguientew;
    siguientew = tamcuadroI*0.25;
    //=================Fecha de nacimiento
    doc=Celda(doc, estudiante && estudiante.fecha_nacimiento ? moment(estudiante.fecha_nacimiento).format('DD/MM/YYYY') : '', inicia, siguienteA, siguientew, altoTexto, letra,'center','bold')
    
    inicia+=siguientew;
    siguientew = tamcuadroI*0.25;
    //=================Lugar de nacimiento
    doc=Celda(doc, estudiante ? estudiante.lugar_nacimiento :'', inicia, siguienteA, siguientew, altoTexto, letra,'center','bold')

    inicia+=siguientew;
    siguientew = tamcuadroI*0.25;
    //=================Estado
    doc=Celda(doc, estudiante && estudiante.estado ? estudiante.estado :'', inicia, siguienteA, siguientew, altoTexto, letra,'center','bold')
    
    //==================================

    inicia = tamimagen+margen;
    siguienteA +=altoTexto;
    siguientew = tamcuadroI*0.40;
    doc=Celda(doc, 'NOMBRE Y DIRECCIÓN DEL PLANTE', inicia, siguienteA, siguientew, altoTexto, letra)
    
    inicia+=siguientew;
    siguientew = tamcuadroI*0.44;
    doc=Celda(doc, 'NOMBRE Y DIRECCIÓN DEL PADRE O REP.', inicia, siguienteA, siguientew, altoTexto, letra)
    
    inicia+=siguientew;
    siguientew = tamcuadroI*0.16;
    doc=Celda(doc, 'AÑO ESCOLAR', inicia, siguienteA, siguientew, altoTexto, letra)

    //==================================

    inicia = tamimagen+margen;
    siguienteA +=altoTexto;
    siguientew = tamcuadroI*0.40;
    texto =doc.splitTextToSize(" CALLE NEGRÓN SILVA, ENTRE AVENIDA INDEPENDENCIA Y CALLE GARCÉS, EDIF. U. E. COLEGIO LIBERTADORES DE AMERICA", siguientew , {})
    doc=Celda(doc, texto, inicia, siguienteA, siguientew, altoTexto+6, letra-1, 'left')
    
    inicia+=siguientew;
    siguientew = tamcuadroI*0.44;
    //================Representante
    doc=Celda(doc, datos.representante ? datos.representante : '', inicia, siguienteA, siguientew, altoTexto+6, letra,'center','bold')
    
    inicia+=siguientew;
    siguientew = tamcuadroI*0.16;
    //===================Periodo Escolar
    doc=Celda(doc, datos.periodo, inicia, siguienteA, siguientew, altoTexto+6, letra,'center','bold')

    //=====================================================
    let completo =tamcuadroI+tamimagen
    inicia = margen;
    siguienteA +=altoTexto+8;
    siguientew = completo*0.35;
    
    doc=Celda(doc, 'Resultados de la Evaluación', inicia, siguienteA, siguientew, altoTexto, letra)

    inicia+=siguientew;
    siguientew = completo*0.65;
    doc=Celda(doc, 'HISTORIA DEL ALUMNO DURANTE EL AÑO ESCOLAR', inicia, siguienteA, siguientew, altoTexto, letra)
    //=====================================================
    inicia = margen;
    siguienteA +=altoTexto;
    siguientew = completo*0.35;
    
    doc=Celda(doc, 'Áreas del Saber o', inicia, siguienteA, siguientew, altoTexto, letra)

    inicia+=siguientew;
    siguientew = completo*0.14;
    doc=Celda(doc, '1er Lapso', inicia, siguienteA, siguientew, altoTexto, letra)
    
    inicia+=completo*0.15; //siguientew;
    siguientew = completo*0.14;
    doc=Celda(doc, '2do Lapso', inicia, siguienteA, siguientew, altoTexto, letra)

    inicia+=completo*0.15;//siguientew;
    siguientew = completo*0.14;
    doc=Celda(doc, '3er Lapso', inicia, siguienteA, siguientew, altoTexto, letra)

    inicia+=completo*0.15;//siguientew;
    siguientew = completo*0.06;
    doc=Celda(doc, 'FINAL', inicia, siguienteA, siguientew, 2*altoTexto, letra)

    inicia+=siguientew;
    siguientew = completo*0.075;
    doc=Celda(doc, 'REVISIÓN', inicia, siguienteA, siguientew, 2*altoTexto, letra)
    inicia+=siguientew;
    siguientew = completo*0.065;
    texto =doc.splitTextToSize("TOTAL inasist", siguientew , {})
    doc=Celda(doc, texto, inicia, siguienteA, siguientew, 2* altoTexto, letra)

    //=====================================================
    inicia = margen;
    siguienteA +=altoTexto;
    siguientew = completo*0.35;
    
    doc=Celda(doc, 'Asignaturas', inicia, siguienteA, siguientew, altoTexto, letra)
    //1er
    inicia+=siguientew;
    siguientew = completo*0.075;
    doc=Celda(doc, 'Def.LP', inicia, siguienteA, siguientew, altoTexto, letra)

    inicia+=siguientew;
    siguientew = completo*0.065;
    doc=Celda(doc, 'Inasist.', inicia, siguienteA, siguientew, altoTexto, letra)
    //2do
    inicia+=completo*0.075;//siguientew;
    siguientew = completo*0.075;
    doc=Celda(doc, 'Def.LP', inicia, siguienteA, siguientew, altoTexto, letra)

    inicia+=completo*0.075;//siguientew;
    siguientew = completo*0.065;
    doc=Celda(doc, 'Inasist.', inicia, siguienteA, siguientew, altoTexto, letra)
    //3er
    inicia+=completo*0.075;//siguientew;
    siguientew = completo*0.075;
    doc=Celda(doc, 'Def.LP', inicia, siguienteA, siguientew, altoTexto, letra)

    inicia+=completo*0.075;//siguientew;
    siguientew = completo*0.065;
    doc=Celda(doc, 'Inasist.', inicia, siguienteA, siguientew, altoTexto, letra)

    //=====================================================
    //=====================================================
    //=====================================================
    let asignaturas=est_titulos.datos[0];
    let alto = altoTexto;
    let momento1 = 0;
    let cmomento1 = 0;
    let momento2 = 0;
    let cmomento2 = 0;
    let momento3 = 0;
    let cmomento3 = 0;
    let momentof = 0;
    let cmomentof = 0;
    for (var num=1; num<asignaturas.length;num++){  
        let materia =  asignaturas[num];
        inicia = margen;
        siguienteA +=alto;
        siguientew = completo*0.35;
        texto =doc.splitTextToSize(materia.title, siguientew , {})
        
        alto = texto.length===1 ? altoTexto : altoTexto + (altoTexto/1.5)//texto.length * altoTexto;
        
        doc=Celda(doc, texto, inicia, siguienteA, siguientew, alto, letra,'left','bold')
        //1er
        inicia+=siguientew;
        siguientew = completo*0.075;
        let pos = materia.title.indexOf('ORIENTACIÓN')!==-1 || materia.title.indexOf('PARTICIPACIÓN')
        let nota = NotaB(estudiante, '1lapso', materia)
        momento1= pos===-1 ? momento1 + Number(nota) : momento1;
        cmomento1 = pos===-1 && nota!=='' ? cmomento1 + 1 : cmomento1;

        doc=Celda(doc, String(nota) , inicia, siguienteA, siguientew, alto, letra, 'center', 'bold')

        inicia+=siguientew;
        siguientew = completo*0.065;
        doc=Celda(doc, '', inicia, siguienteA, siguientew, alto, letra)
        //2do
        inicia+=completo*0.075;//siguientew;
        siguientew = completo*0.075;
        pos = materia.title.indexOf('ORIENTACIÓN')!==-1 || materia.title.indexOf('PARTICIPACIÓN')
        nota = NotaB(estudiante, '2lapso', materia)
        momento2= pos===-1 ? momento2 + Number(nota) : momento2;
        cmomento2 = pos===-1 && nota!=='' ? cmomento2 + 1 : cmomento2;
        doc=Celda(doc, String(nota), inicia, siguienteA, siguientew, alto, letra, 'center', 'bold')

        inicia+=siguientew;
        siguientew = completo*0.065;
        doc=Celda(doc, '', inicia, siguienteA, siguientew, alto, letra)
        //3er
        inicia+=completo*0.075;//siguientew;
        siguientew = completo*0.075;
        nota = NotaB(estudiante, '3lapso', materia)
        momento3= pos===-1 ? momento3 + Number(nota) : momento3;
        cmomento3 = pos===-1 && nota!=='' ? cmomento3 + 1 : cmomento3;
        doc=Celda(doc, String(nota), inicia, siguienteA, siguientew, alto, letra)

        inicia+=siguientew;
        siguientew = completo*0.065;
        
        doc=Celda(doc, '', inicia, siguienteA, siguientew, alto, letra, 'center', 'bold')

        inicia+=completo*0.075;//siguientew;
        siguientew = completo*0.06;
        pos = materia.title.indexOf('ORIENTACIÓN')!==-1 || materia.title.indexOf('PARTICIPACIÓN')
        nota = estudiante[`${materia.field}-def`] //[`1lapso-${materia.field}`] 
            ? pos===-1 
            ? Nota_Entera(estudiante[`${materia.field}-def`]) 
            : Literal(estudiante[`${materia.field}-def`]) 
            : '';
        
        momentof= pos===-1 ? momentof + Number(nota) : momentof;
        cmomentof = pos===-1 && nota!=='' ? cmomentof + 1 : cmomentof;
        doc=Celda(doc, String(nota), inicia, siguienteA, siguientew, alto, letra, 'center', 'bold')

        inicia+=siguientew;
        siguientew = completo*0.075;
        doc=Celda(doc, '', inicia, siguienteA, siguientew, alto, letra)
        inicia+=siguientew;
        siguientew = completo*0.065;
        
        doc=Celda(doc, '', inicia, siguienteA, siguientew, alto, letra)
    }
    
    inicia = margen;
    siguienteA +=2*altoTexto;
    siguientew = completo*0.35;
    
    doc=Celda(doc, 'PROMEDIO', inicia, siguienteA, siguientew, altoTexto, letra, 'center', 'bold')
    //1er
    inicia+=siguientew;
    siguientew = completo*0.075;
    
    doc=Celda(doc, cmomento1===0 ? '' :(momento1/cmomento1).toFixed(2), inicia, siguienteA, siguientew, altoTexto, letra, 'center', 'bold')

    inicia+=siguientew;
    siguientew = completo*0.065;
    doc=Celda(doc, '', inicia, siguienteA, siguientew, altoTexto, letra)
    //2do
    inicia+=completo*0.075;//siguientew;
    siguientew = completo*0.075;
    
    doc=Celda(doc, cmomento2===0 ? '' : (momento2/cmomento2).toFixed(2), inicia, siguienteA, siguientew, altoTexto, letra)

    inicia+=completo*0.075;//siguientew;
    siguientew = completo*0.065;
    doc=Celda(doc, '', inicia, siguienteA, siguientew, altoTexto, letra)
    //3er
    inicia+=completo*0.075;//siguientew;
    siguientew = completo*0.075;
    doc=Celda(doc, cmomento3===0 ? '' : (momento3/cmomento3).toFixed(2), inicia, siguienteA, siguientew, altoTexto, letra)

    inicia+=completo*0.075;//siguientew;
    siguientew = completo*0.065;
    doc=Celda(doc, '', inicia, siguienteA, siguientew, altoTexto, letra)

    inicia+=completo*0.075;//siguientew;
    siguientew = completo*0.06;
    
    doc=Celda(doc, cmomentof===0 ? '' : (momentof/cmomentof).toFixed(2), inicia, siguienteA, siguientew, altoTexto, letra)

    inicia+=siguientew;
    siguientew = completo*0.075;
    doc=Celda(doc, '', inicia, siguienteA, siguientew, altoTexto, letra)
    inicia+=siguientew;
    siguientew = completo*0.065;
    doc=Celda(doc, '', inicia, siguienteA, siguientew, altoTexto, letra)
    //==================================
    //=================================
    inicia = 2* margen;
    siguienteA +=2*altoTexto;
    siguientew = completo*0.25;
    
    doc=Celda(doc, 'SELLO', inicia, siguienteA, siguientew, 6* altoTexto, letra)

    inicia+=completo * 0.342;
    siguientew = completo*0.18;
    
    doc=Celda(doc, "FECHA", inicia, siguienteA, siguientew, altoTexto, letra)
    inicia+=siguientew;
    siguientew = completo*0.22;
    doc=Celda(doc, "FIRMA DEL PROF. GUÍA", inicia, siguienteA, siguientew, altoTexto, letra)
    inicia+=siguientew;
    siguientew = completo*0.22;
    doc=Celda(doc, "FIRMA DEL REPRESENTANTE", inicia, siguienteA, siguientew, altoTexto, letra)
    //================================
    inicia = 2* margen;
    siguienteA +=altoTexto;
    siguientew = completo*0.25;

    inicia+=completo * 0.342;
    siguientew = completo*0.18;
    
    doc=Celda(doc, moment().format('MMM-YYYY'), inicia, siguienteA, siguientew, altoTexto, letra, 'center', 'bold')
    inicia+=siguientew;
    siguientew = completo*0.22;
    doc=Celda(doc, "", inicia, siguienteA, siguientew, 3*altoTexto, letra)
    inicia+=siguientew;
    siguientew = completo*0.22;
    doc=Celda(doc, "", inicia, siguienteA, siguientew, 3*altoTexto, letra)
    //================================
    inicia = 2* margen;
    siguienteA +=altoTexto;
    siguientew = completo*0.25;

    inicia+=completo * 0.342;
    siguientew = completo*0.18;
    
    doc=Celda(doc, "LAPSO DE EVALUACIÓN", inicia, siguienteA, siguientew, altoTexto, letra)
    //================================
    inicia = 2* margen;
    siguienteA +=altoTexto;
    siguientew = completo*0.25;

    inicia+=completo * 0.342;
    siguientew = completo*0.18;
    
    doc=Celda(doc, momento3!==0 ? "TERCERO" : momento2!==0 ? "SEGUNDO" :"PRIMERO", inicia, siguienteA, siguientew, altoTexto, letra, 'center', 'bold')
    return doc
}
export const FormatoBoletapdf = (props)=>{
    const {est_datos, est_titulos, datos} = props;
    
    // let asignatura = await Asignaturas(datos.grado);
    var doc = new jsPDF( );
    const totalPagesExp = '{total_pages_count_string}'
    var y = 5;
    
    const pageSize = doc.internal.pageSize
    const pageWidth = pageSize.width ? pageSize.width : pageSize.getWidth()
    const pageAlto = pageSize.height ? pageSize.height : pageSize.getHeight()
    

    const margen = 8;
    const margenAlto = 8;
    const altoTexto = 4;
    const tamcuadroI= (pageWidth *0.80)-margen;
    const tamimagen = (pageWidth *0.20)-margen;
    let letra =8;
    
    doc.setFont("arial");
    doc.setFontSize(letra)
    
    // if (est_datos)
    for (var i=0; i< est_datos.length;i++){
        if (i!==0 && i%2===0){
            doc.addPage();
        }else if (i!==0){
            //Linea media
            doc.line(0, pageAlto/2, pageWidth, pageAlto/2); // horizontal line        
        }
        doc = Boleta(doc,tamcuadroI, margen, i%2===0 ? margenAlto : (pageAlto/2) + margenAlto, altoTexto, tamimagen, letra, datos,est_datos[i], est_titulos)    
    }
    // doc = Boleta(doc,tamcuadroI, margen, margenAlto, altoTexto, tamimagen, letra, datos,est_datos[0], est_titulos)
    
    //Linea media
    // doc.line(0, pageAlto/2, pageWidth, pageAlto/2); // horizontal line

    // doc = Boleta(doc,tamcuadroI, margen, (pageAlto/2) + margenAlto, altoTexto, tamimagen, letra, datos,est_datos[0], est_titulos)
    
    return (
        <embed src={`${doc.output('bloburl')}#view=Fit=1&toolbar=1&navpanes=0&scrollbar=1`} type="application/pdf" width="100%" height={'100%' } />
        
    )
}

export const TitulosNotas = async(titulosn, ntipo)=>{
    const Config = Ver_Valores().config;
    let est_titulos = await Titulos_todos(`Titulos_Notas`, Config);
    est_titulos = est_titulos.map(val=>{
        return {...val, }
    })
    let fila1 = titulosn.datos[0].map(asig=>{
        return {
            default : "",
            field : `${asig.field}`,
            formato : (dato)=> dato[asig.field] ? Number(dato[asig.field]).toFixed(2) : '',
            orden: false, 
            tipo : "",
            title : asig.titulo,
            type : "number",
            lapso:asig.lapso,
            vertical:false,
            colSpan:7,                  

        }
    })
                    
    const fila2 = titulosn.datos[1].map(asig=>{
        const definitiva = (asig.field.indexOf("-def")!==-1 || asig.field.indexOf("1lapso-")!==-1 || asig.field.indexOf("2lapso-")!==-1 || asig.field.indexOf("3lapso-")!==-1)
                            && (asig.field.indexOf("-art112")===-1 && asig.field.indexOf("-rasgos")===-1) 
        const tipo =ntipo.value;
        
        return {
            default : "",
            field : `${asig.field}`,
            formato : (dato)=> dato[asig.field] 
                ?   definitiva 
                        ?   Nota_Entera(Number(tipo==='seccion' && dato[`${asig.field}-art112`] 
                                                ?   dato[`${asig.field}-art112`]
                                                :   dato[asig.field]
                                            ))
                        :   Number(dato[asig.field]).toFixed(2) 
                :   '',
            orden: false, 
            tipo : "",
            title : asig.titulo,
            type : "number",
            lapso:asig.lapso,
            vertical:asig.vertical ? asig.vertical : false, 

        }
    })
    est_titulos=[
        {
            ...est_titulos[0],
            fija:true, minWidth:400,//window.innerWidth * 0.3,
            title:'APELLIDOS NOMBRES',
            formato:(dato)=>{
                return `${dato.apellidos} ${dato.nombres}`
            }
        }
    ]
    fila1 =fila1.length!==0 ? [...est_titulos.map(val=>{return{...val, title:'ESTUDIANTES', orden:false}}), ...fila1] :[];
    est_titulos={filas:2 ,datos:[fila1,[...est_titulos, ...fila2]], values:[...est_titulos,...fila2]};
    return est_titulos
} 